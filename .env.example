# Notion Integration Settings
NOTION_KEY=your_notion_integration_secret_token_here
NOTION_DATABASE_ID=your_notion_database_uuid_here

# Firebase (server-side, via process.env)
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxx
FIREBASE_API_KEY=your_api_key

# Firebase (client-side, via import.meta.env — must be VITE_-prefixed)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxx
VITE_FIREBASE_API_KEY=your_api_key

# Firebase Admin SDK (server-side writes bypass security rules).
# Generate a service account key in Firebase console:
#   Project settings → Service accounts → Generate new private key
# Provide it either as FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON, e.g. on Vercel)
# or as a firebase-admin-key.json file in the repo root (dev, gitignored).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
