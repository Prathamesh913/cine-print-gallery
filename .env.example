# Notion Integration Settings
NOTION_KEY=your_notion_integration_secret_token_here
NOTION_DATABASE_ID=your_notion_database_uuid_here

# Firebase (server-side, via process.env)
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxx
FIREBASE_API_KEY=your_api_key

# Firebase (client-side, via import.meta.env — must be VITE_-prefixed)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxx
VITE_FIREBASE_API_KEY=your_api_key

# TMDB (automation enrichment)
TMDB_API_KEY=your_tmdb_api_v3_key_here

# Raindrop (automated ingestion). Create an app token in Raindrop settings.
RAINDROP_ACCESS_TOKEN=your_raindrop_test_or_app_token_here
RAINDROP_COLLECTION_ID=your_designated_collection_id_here

# Notion identity data source used for multi-image editorial pages.
# Optional for single-image pages, which use the CinePrint Poster ID property.
NOTION_POSTER_IDENTITIES_DATA_SOURCE_ID=your_notion_data_source_id_here

# Cloudflare R2 (automated ingestion + migration). Never use the r2.dev domain.
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_BASE_URL=https://images.cineprint.click

# Automated ingestion tuning (optional; defaults shown).
# INGESTION_CONCURRENCY=2
# INGESTION_BATCH_LIMIT=25
# INGESTION_MAX_ATTEMPTS=3
# INGESTION_RETRY_DELAY_MS=60000
# INGESTION_MAX_PAGES=4
# INGESTION_HTTP_TIMEOUT_MS=20000
# INGESTION_HTTP_RETRIES=3
# NOTION_TIMEOUT_MS=30000
# INGESTION_DOWNLOAD_TIMEOUT_MS=60000
# INGESTION_DOWNLOAD_MAX_BYTES=31457280

# Vercel Blob (LEGACY manual import only: `npm run import:raindrop`).
# The automated pipeline never writes to Vercel Blob. Keep these only while the
# manual importer remains available.
# Preferred: long-lived read-write token (does not expire). Get it from the
# Vercel dashboard (Storage → your Blob store → `.env.local` snippet) or from
# a project env var named BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here
# Alternative: short-lived (~12h) OIDC token + store id. VERCEL_OIDC_TOKEN is
# generated by Vercel (e.g. `npx vercel env pull` → .env.vercel / .env.local)
# and must be re-pulled every ~12 hours.
# BLOB_STORE_ID is the public store id from the Vercel dashboard (Storage → Blob store).
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here
BLOB_STORE_ID=your_blob_store_id_here

# Firebase Admin SDK (server-side writes bypass security rules).
# Generate a service account key in Firebase console:
#   Project settings → Service accounts → Generate new private key
# Provide it either as FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON, e.g. on Vercel)
# or as a firebase-admin-key.json file in the repo root (dev, gitignored).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
